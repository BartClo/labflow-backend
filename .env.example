# LabFlow Backend Environment Configuration
# Copy this file to .env and configure your specific values

# =================================
# DATABASE CONFIGURATION
# =================================
# PostgreSQL database connection
# For local development:
DB_URL=jdbc:postgresql://localhost:5432/labflow_db
DB_USERNAME=labflow_user
DB_PASSWORD=labflow_password

# For Render deployment, use:
# DB_URL=[Internal Database URL from Render PostgreSQL]
# DB_USERNAME=labflow_user
# DB_PASSWORD=[Password from Render PostgreSQL]

# =================================
# SERVER CONFIGURATION
# =================================
# Application server settings
SERVER_PORT=8080

# =================================
# SWAGGER/API DOCUMENTATION
# =================================
# Enable/disable Swagger UI in production
SWAGGER_ENABLED=true

# =================================
# LOGGING CONFIGURATION
# =================================
# General application logging level
LOG_LEVEL=INFO

# SQL query logging (DEBUG for development, WARN for production)
SQL_LOG_LEVEL=DEBUG

# =================================
# SPRING PROFILES
# =================================
# Active profile (dev, test, prod)
# Use 'prod' for Render deployment
SPRING_PROFILES_ACTIVE=dev

# =================================
# DEVELOPMENT SETTINGS
# =================================
# These are typically only used in development

# JPA/Hibernate settings (usually controlled by application.properties)
# DDL_AUTO=update
# SHOW_SQL=true

# Flyway settings (usually controlled by application.properties)
# FLYWAY_ENABLED=true
# FLYWAY_BASELINE_ON_MIGRATE=true

# =================================
# PRODUCTION SETTINGS (Optional)
# =================================
# Uncomment and configure for production deployment

# File upload limits
# MAX_FILE_SIZE=10MB
# MAX_REQUEST_SIZE=10MB

# PostgreSQL connection pool settings
# POSTGRES_MAX_POOL_SIZE=20
# POSTGRES_CONNECTION_TIMEOUT=30000

# Security settings
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRATION=86400000

# External service URLs
# EXTERNAL_API_URL=https://api.example.com
# EXTERNAL_API_KEY=your-api-key-here